# Dayflow HRMS Backend Configuration
PORT=8080
ENV=development

# Supabase PostgreSQL Service Connection String (Bypasses RLS)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# JWT Authentication
JWT_SECRET=super-secret-dayflow-jwt-token-key-change-in-production-2026
JWT_EXPIRY_HOURS=72

# Default Company Code fallback
DEFAULT_COMPANY_CODE=DF

# Allowed CORS Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
